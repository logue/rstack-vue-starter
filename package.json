{
  "name": "rstack-vue-starter",
  "version": "1.6.4",
  "private": true,
  "description": "Vue3 TypeScript Starter project for Rstack.",
  "homepage": "https://github.com/logue/rstack-vue-starter",
  "bugs": {
    "url": "https://github.com/logue/rstack-vue-starter/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/rstack-vue-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "rs dev --open",
    "lint": "run-s lint:*",
    "lint:check": "vize lint --type-aware",
    "lint:oxlint": "oxlint --fix",
    "lint:oxfmt": "oxfmt",
    "analyze": "RSDOCTOR=true rs build",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "rs build preview",
    "clean": "rimraf dist",
    "clean:hard": "rimraf .rstack/cache .rstack/.rsdoctor demo dist docs node_modules/.tmp node_modules/.cache",
    "build-only": "rs build",
    "type-check": "vize check --tsconfig tsconfig.rsbuild.json",
    "skills:install": "npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m'",
    "skills:update": "npx skills update",
    "prepare": "rs hooks && pnpm run skills:install"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsdoctor/agent-cli": "^0.1.2",
    "@rsdoctor/core": "^2.0.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/node": "^26.6.6",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.4",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "rimraf": "^6.1.4",
    "rstack": "^0.9.2",
    "taze": "^21.3.0",
    "typescript": "^7.0.2",
    "vize": "^0.765.0"
  },
  "packageManager": "pnpm@12.21.0",
  "stackblitz": {
    "startCommand": "pnpm run test:unit"
  }
}
